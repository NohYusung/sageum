# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Server-only provider credentials
SUPABASE_SECRET_KEY=sb_secret_example
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=replace-me
QDRANT_COLLECTION=document_chunks_embeddinggemma_q8
QDRANT_SCORE_THRESHOLD=0.45

# Default: browser-side EmbeddingGemma 300M ONNX Q8. No embedding API key is required.
EMBEDDING_PROVIDER=browser-embeddinggemma

# Optional server-side alternatives: gemini, google, openai, openai-compatible.
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_API_KEY=replace-me
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_BASE_URL=https://api.openai.com/v1
