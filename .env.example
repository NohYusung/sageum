# Sageum Agent
SAGEUM_AGENT_HOST=127.0.0.1
SAGEUM_AGENT_PORT=4123

# Codex OAuth runtime
SAGEUM_CODEX_MODEL=gpt-5.3-codex
SAGEUM_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
# SAGEUM_CODEX_ACCESS_TOKEN=
# SAGEUM_CODEX_AUTH_FILE=/Users/you/.sageum-agent/auth.json
# CODEX_HOME=/Users/you/.codex

# Web search
# SAGEUM_SEARXNG_URL=http://127.0.0.1:8080
# BRAVE_SEARCH_API_KEY=

# Worker behavior
SAGEUM_SEARCH_LIMIT=5
SAGEUM_EXTRACT_LIMIT=3
SAGEUM_CALLBACK_TIMEOUT_SECONDS=20
