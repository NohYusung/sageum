# Sageum Agent
SAGEUM_AGENT_HOST=127.0.0.1
SAGEUM_AGENT_PORT=4123

# Codex OAuth runtime
# Defaults to ~/.codex/config.toml model when present, otherwise gpt-5.5.
# SAGEUM_CODEX_MODEL=gpt-5.5
# SAGEUM_CODEX_MODEL_FALLBACKS=gpt-5.5,gpt-5.4,gpt-5,gpt-5-codex,gpt-5.2-codex
SAGEUM_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
# SAGEUM_CODEX_ACCESS_TOKEN=
# SAGEUM_CODEX_AUTH_FILE=/Users/you/.sageum-agent/auth.json
# CODEX_HOME=/Users/you/.codex

# Web search
# Default is duckduckgo: no API key, DuckDuckGo HTML search with r.jina.ai fallback.
SAGEUM_WEB_BACKEND=duckduckgo
# Extract default is jina: r.jina.ai reader first, direct fetch fallback.
SAGEUM_EXTRACT_READER=jina
# SAGEUM_SEARXNG_URL=http://127.0.0.1:8080
# SAGEUM_BRAVE_SEARCH_API_KEY=
# SAGEUM_TAVILY_API_KEY=
# SAGEUM_EXA_API_KEY=

# Worker behavior
SAGEUM_SEARCH_LIMIT=5
SAGEUM_EXTRACT_LIMIT=3
SAGEUM_CALLBACK_TIMEOUT_SECONDS=20
