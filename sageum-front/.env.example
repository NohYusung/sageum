# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional canonical URL for auth email redirects. Vercel requests infer this automatically.
NEXT_PUBLIC_SITE_URL=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

# Embedding configuration is intentionally provider-neutral.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=768
