# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional canonical URL for auth email redirects. Vercel requests infer this automatically.
NEXT_PUBLIC_SITE_URL=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks
QDRANT_SCORE_THRESHOLD=0.45

# Free-demo default. Supported providers: gemini, google, openai, openai-compatible.
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Optional override for provider-compatible endpoints.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
