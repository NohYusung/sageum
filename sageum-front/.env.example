# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
QDRANT_URL=
QDRANT_API_KEY=
