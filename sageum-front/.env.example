# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional canonical URL for auth email redirects. Vercel requests infer this automatically.
NEXT_PUBLIC_SITE_URL=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks_qdrant_hybrid_v2
QDRANT_RELATION_COLLECTION=knowledge_relations_qdrant_v1
QDRANT_INFERENCE_MODEL=intfloat/multilingual-e5-small
QDRANT_INFERENCE_DIMENSIONS=384
# RRF hybrid scores are model- and corpus-dependent. Tune after evaluating demo documents.
QDRANT_SCORE_THRESHOLD=0.2
QDRANT_RELATION_SCORE_THRESHOLD=0.35
QDRANT_RULE_BINDING_SCORE_THRESHOLD=0.2
QDRANT_RULE_RULE_SCORE_THRESHOLD=0.35

# Claude Platform on AWS (not Amazon Bedrock)
# The region must match the region where the Claude Platform workspace was created.
ANTHROPIC_AWS_WORKSPACE_ID=
AWS_REGION=
# Recommended for Vercel. Generate this key in AWS Console > Claude Platform on AWS > API keys.
ANTHROPIC_AWS_API_KEY=
CLAUDE_AWS_MODEL=claude-haiku-4-5

# OAuth-protected MCP. Authentication is issued by Supabase OAuth 2.1.
# Optional comma-separated browser origins. CLI/agent clients normally send no Origin header.
SAGEUM_MCP_ALLOWED_ORIGINS=
# Used only by the local MCP smoke script. Do not configure the access token in Vercel.
SAGEUM_MCP_URL=http://localhost:3000/api/mcp
SAGEUM_MCP_ACCESS_TOKEN=
