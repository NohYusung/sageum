    "qdrant:smoke": "node --env-file=.env.local --import tsx scripts/smoke-qdrant.ts",
    "claude:smoke": "node --env-file=.env.local --import tsx scripts/smoke-claude-aws.ts",
    "mcp:smoke": "node --env-file=.env.local --import tsx scripts/smoke-mcp.ts"
  },
  "dependencies": {
    "@anthropic-ai/aws-sdk": "0.6.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@qdrant/js-client-rest": "1.18.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "@workflow/next": "^4.1.4",
    "cheerio": "1.2.0",
    "exceljs": "4.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "1.12.0",
    "next": "16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
